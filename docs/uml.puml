@startuml
title FiniteStateMachine Architecture
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

package "FSM" {
  class Number {
    - value : double
    - isFloating : bool
    - isSigned : bool
    - notanumber : bool
    + Number()
    + Number(val)
    + isNaN() : bool
    + toString(floating=2) : String
    + minimum(a, b) : Number
    + maximum(a, b) : Number
    + operator+(rhs) : Number
    + operator-(rhs) : Number
    + operator*(rhs) : Number
    + operator/(rhs) : Number
  }

  class "detail::OwnedKey" as OwnedKey {
    - buffer : String
    - present : bool
    + OwnedKey(key)
    + operator fsm_key_t() const
  }

  enum comparators_t {
    CMP_NOP
    CMP_EQU
    CMP_NEQ
    CMP_LES
    CMP_LEQ
    CMP_GTR
    CMP_GEQ
  }

  note left of comparators_t
  Think of CMP_NOP as "no real comparison selected."
  When that happens, the library falls back to a fixed answer:
  - For boolean states, it acts like the condition passed.
  - For numeric and timestamp states, it acts like the condition failed.
  So CMP_NOP can trigger bool callbacks, but normally will not
  trigger Number or time-based callbacks.
  end note

  enum callback_type_t {
    CB_NONE
    CB_COMP
    CB_COMPVAL
    CB_COMPVALREF
  }

  class "ConditionalCallback<T>" as ConditionalCallbackT {
    # key : OwnedKey
    # comparator : comparators_t
    # reference : T
    # invert : bool
    # disabled : bool
    # callback : void*
    # callbacktype : callback_type_t
    # getReference : cb_getref_t
    + operator()(val : T)
    + operator()(val : T, ref : T)
    + compare(cmp, val, ref) : bool
    + disable()
    + enable()
    + enable(val : T)
    + getKey() : fsm_key_t
    # childCallback(comp : bool, val : T, ref : T)
    # childReference(val : T) : T
    # callOperator(val : T, ref : T)
    # executeCallback(val : T, ref : T)
    # setComparator(cmp : comparators_t)
  }

  class "State<T>" as StateT {
    - value : T
    - defaultValue : T
    - disabled : bool
    - numconditionals : uint8
    # key : OwnedKey
    # conditionals : ConditionalCallback<T>*[10]
    + State(value : T)
    + State(value : T, key : fsm_key_t)
    + get() : T
    + set(val : T)
    + addConditional(...)
    + removeConditional(conditional)
    + addConditionalSetFlag(...)
    + addLatchingConditional(...)
    + addLatchingSetFlag(...)
    + addCallback(cb)
    + enable()
    + enable(val : T)
    + resume()
    + disable()
    + disable(val : T)
    + isDisabled() : bool
    + toString() : String
    + toString(val : T) : String
  }

  class Variable {
    + Variable(value : Number)
    + Variable(value : numeric)
  }

  class Flag {
    + Flag(value=false)
    + Flag(value, key)
    + Flag(key)
  }

  class "FlagSetCondition<T>" as FlagSetConditionT {
    # flag : Flag*
    # childCallback(comp, val, ref)
  }

  class BangBangConditional {
    - state : bool
    - triggered : bool
    - low : Number
    - high : Number
    - rising : void*
    - falling : void*
    # childReference(val) : Number
    # childCallback(comp, val, ref)
    # callOperator(val, ref)
  }

  class LatchingConditional {
    - state : bool
    - triggered : bool
    - rising : void*
    - falling : void*
    # childReference(val) : bool
    # childCallback(comp, val, ref)
    # callOperator(val, ref)
  }

  class BangBangFlagSet {
    - state : bool
    - triggered : bool
    - low : Number
    - high : Number
    # childReference(val) : Number
    # childCallback(comp, val, ref)
    # callOperator(val, ref)
  }

  class LatchingFlagSet {
    - state : bool
    - triggered : bool
    # childReference(val) : bool
    # childCallback(comp, val, ref)
    # callOperator(val, ref)
  }

  class IntervalCallback {
    - now : fsm_timestamp_t
    - phase : fsm_timestamp_t
    - delta : fsm_timestamp_t
    - refholder : fsm_timestamp_t
    + get() : fsm_timestamp_t
    + set(val : fsm_timestamp_t)
    + getDelta() : fsm_timestamp_t
    + setDelta(val)
    + getPhase() : fsm_timestamp_t
    + setPhase(val)
    + getInvert() : bool
    + setInvert(val)
    # childReference(val) : fsm_timestamp_t
  }

  class FlagInterval {
    - flag : Flag*
    # childCallback(comp, val, ref)
  }

  class ChronoEvent {
    - triggered : bool
    - refholder : fsm_timestamp_t
    + getTimestamp() : fsm_timestamp_t
    + setTimestamp(val)
    + getInvert() : bool
    + setInvert(val)
    # childReference(val) : fsm_timestamp_t
    # callOperator(val, ref)
  }

  class FlagEvent {
    - flag : Flag*
    - triggered : bool
    # childCallback(comp, val, ref)
    # callOperator(val, ref)
  }

  class Chronograph {
    - start : fsm_timestamp_t
    - intervals : IntervalCallback*[16]
    + set(val : fsm_timestamp_t)
    + get() : fsm_timestamp_t
    + addEvent(...)
    + addEventFlag(...)
    + addInterval(...)
    + addIntervalFlag(...)
    + addTwentyFourTimeout(...)
    + removeInterval(interval)
    + removeConditional(conditional)
  }

  object Chronos <<global instance>>

  object "Utility API" as UtilityAPI {
    + parseComparator(cmp, result=true) : const char*
    + stateToString<T>(val : T) : String
    + timestampToString(val : fsm_timestamp_t) : String
  }
}

Variable --|> StateT : State<Number>
Flag --|> StateT : State<bool>
Chronograph --|> StateT : State<fsm_timestamp_t>\n(protected)
IntervalCallback --|> ConditionalCallbackT : ConditionalCallback<fsm_timestamp_t>\n(protected)
FlagInterval --|> IntervalCallback
ChronoEvent --|> ConditionalCallbackT : ConditionalCallback<fsm_timestamp_t>
FlagEvent --|> ChronoEvent

FlagSetConditionT --|> ConditionalCallbackT
BangBangConditional --|> ConditionalCallbackT : ConditionalCallback<Number>
LatchingConditional --|> ConditionalCallbackT : ConditionalCallback<bool>
BangBangFlagSet --|> FlagSetConditionT : FlagSetCondition<Number>
LatchingFlagSet --|> FlagSetConditionT : FlagSetCondition<bool>

StateT *-- "0..10" ConditionalCallbackT : owns
Chronograph *-- "0..16" IntervalCallback : owns
FlagSetConditionT --> Flag : sets
FlagInterval --> Flag : toggles
FlagEvent --> Flag : sets
Chronos ..> Chronograph : instance of

ConditionalCallbackT *-- OwnedKey : key
StateT *-- OwnedKey : key
UtilityAPI ..> Number
ConditionalCallbackT ..> comparators_t
ConditionalCallbackT ..> callback_type_t
StateT ..> FlagSetConditionT : creates
StateT ..> BangBangConditional : creates\n(addLatchingConditional Number)
StateT ..> LatchingConditional : creates\n(addLatchingConditional bool)
StateT ..> BangBangFlagSet : creates\n(addLatchingSetFlag Number/time)
StateT ..> LatchingFlagSet : creates\n(addLatchingSetFlag bool)

note right of StateT
State is the reactive container.
set(val) stores value and evaluates each attached conditional
unless disabled.
end note

note right of ConditionalCallbackT
Callbacks support dynamic reference sources via getReference,
comparator inversion, and four callback signatures.
end note

note right of Chronograph
Chronograph wraps a timestamp State and updates interval
objects using elapsed delta each tick.
end note

note right of Number
Typed numeric wrapper used by Variable and bang-bang logic.
Tracks integer vs floating and signedness metadata, plus NaN.
Useful when embedded code must preserve intent across arithmetic.
end note

note right of OwnedKey
Small ownership adapter for fsm_key_t.
Converts optional const char* identifiers into safe String storage.
Used by State and ConditionalCallback for debug labeling.
end note

note right of Variable
Primary numeric state node.
Use Variable for counters, sensor values, or computed quantities.
Attach callbacks and latching/bang-bang conditionals directly.
end note

note right of Flag
Boolean state node for on/off behavior.
Often used as an actuator gate controlled by other states.
Pairs with latching and interval/event helpers for scheduling.
end note

note right of FlagSetConditionT
Bridge condition: compare source state, then write result to Flag.
Use to convert threshold logic into stable boolean control signals.
Derived classes specialize hysteresis and latching behavior.
end note

note right of BangBangConditional
Numeric hysteresis comparator with high/low thresholds.
Triggers on edge crossings and suppresses chatter near boundaries.
Typical use: thermostat or debounce-like threshold control.
end note

note right of LatchingConditional
Boolean edge latch.
Alternates internal expectation after each successful trigger,
so callbacks fire on transitions rather than steady levels.
end note

note right of BangBangFlagSet
Hysteresis-to-flag adapter.
Implements bang-bang threshold tracking, then sets target Flag.
Designed for robust actuator toggling from analog-style inputs.
end note

note right of LatchingFlagSet
Boolean latch-to-flag adapter.
Converts alternating true/false events into deterministic Flag writes.
Useful when control flow needs explicit edge-driven toggles.
end note

note right of IntervalCallback
Periodic trigger primitive driven by Chronograph time progression.
Supports optional phase offset and inversion.
Use as the base mechanism for fixed-rate recurring actions.
end note

note right of FlagInterval
IntervalCallback variant that writes directly to a Flag.
Use for schedule windows such as periodic enable/disable outputs.
end note

note right of ChronoEvent
One-shot time threshold trigger.
Fires when current time reaches configured timestamp,
with reset behavior handled by comparator state.
end note

note right of FlagEvent
ChronoEvent variant that writes to a Flag.
Use for timed turn-on or turn-off points in a daily cycle.
end note

note right of Chronos
Library-level global Chronograph instance.
Most sketches use this singleton as the central software clock.
Drive it by calling Chronos.set(millis()) in the main loop.
end note

note right of UtilityAPI
Shared conversion and comparator presentation helpers.
Primarily intended for debug output and diagnostics.
Keeps state/condition classes focused on behavior.
end note

@enduml

@startuml
title FiniteStateMachine library - callback evaluation flow

start
:State<T>.set(val);
if (state disabled?) then (yes)
  :store value only;
else (no)
  :for each ConditionalCallback;
endif

:ConditionalCallback.operator()(val);
if (callback disabled?) then (yes)
  :skip;
else (no)
  if (getReference provided?) then (yes)
    :reference = getReference(val);
  else (no)
    :reference = childReference(val);
  endif
  :result = compare(comparator, val, reference);
  if (result true?) then (yes)
    if (callback pointer null?) then (yes)
      :childCallback(invert-adjusted, val, ref);
    else (no)
      :dispatch by callback_type_t;
    endif
  else (no)
    :no action;
  endif
endif

stop

@enduml